---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProductsPage from '../components/pages/ProductsPage.astro'
import { getSiteContent } from '../content/site'

const locale = 'en' as const
const c = getSiteContent(locale)
---

<BaseLayout
  locale={locale}
  title={c.products.title}
  description={c.products.description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: c.products.heading, path: '/products' },
  ]}
  mainEntity={{
    '@type': 'Product',
    name: c.products.entry.name,
    description: c.products.entry.description,
    category: 'AI design generation software',
    brand: { '@type': 'Brand', name: c.meta.siteName },
    manufacturer: { '@id': 'https://zero-agentic.com/#organization' },
    additionalProperty: {
      '@type': 'PropertyValue',
      name: 'Development status',
      value: c.products.entry.specs.find(({ stamp }) => stamp)?.value,
    },
  }}
>
  <ProductsPage locale={locale} />
</BaseLayout>
