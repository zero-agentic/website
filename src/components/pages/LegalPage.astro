---
import type { ILegalDoc } from '../../content/site/types'
import SectionHeading from '../SectionHeading.astro'

interface Props {
  doc: ILegalDoc
}

const { doc } = Astro.props
---

{/* 法务页是长文阅读面：不铺场，只留干净的底与最大的行宽舒适度 */}
<article class="shell pb-20 pt-32 sm:pt-40">
  <header class="max-w-[70ch]">
    <SectionHeading n={doc.n} title={doc.heading} as="h1" />

    <dl class="mt-7 mb-0 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="label m-0">{doc.effectiveLabel}</dt>
      <dd class="m-0 text-[0.9375rem] text-fg">{doc.effective}</dd>
    </dl>

    <p class="mt-9 mb-0 text-[1.125rem] leading-relaxed text-fg">{doc.intro}</p>
  </header>

  <div class="mt-16">
    {
      doc.clauses.map((clause) => (
        <section
          class="row grid gap-x-10 gap-y-3 md:grid-cols-[3.5rem_1fr]"
          id={`c${clause.n}`}
        >
          <p class="m-0 pt-0.5 text-[0.875rem] font-semibold text-fg-3 tabular">
            {clause.n.padStart(2, '0')}
          </p>
          <div>
            <h2 class="title-md">{clause.title}</h2>
            {clause.body.map((para) => (
              <p class="mt-4 mb-0 max-w-[72ch] text-[0.9375rem] leading-[1.8] text-fg-2">{para}</p>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</article>
