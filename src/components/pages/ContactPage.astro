---
import { getSiteContent } from '../../content/site'
import type { Locale } from '../../content/site/types'
import PageHeader from '../PageHeader.astro'
import SectionHeading from '../SectionHeading.astro'
import Footnotes from '../Footnotes.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = getSiteContent(locale)
const ct = c.contact
---

<PageHeader n={ct.n} heading={ct.heading}>
  <div class="surface mt-12" style="animation-delay:120ms">
    <a
      href={`mailto:${ct.email}`}
      class="font-display text-[clamp(1.5rem,5.5vw,3.25rem)] font-medium leading-tight tracking-[-0.045em] text-fg no-underline transition-colors duration-200 hover:text-brand-2-ink"
    >
      <span class="break-all underline decoration-brand-2 decoration-[3px] underline-offset-[0.22em]">
        {ct.email}
      </span>
    </a>
    <p class="mt-8 mb-0 max-w-[54ch] text-[1.0625rem] leading-relaxed text-fg-2">{ct.intro}</p>
  </div>
</PageHeader>

<section class="shell" id="channels">
  <SectionHeading title={ct.channelsLabel} class="border-t border-line pt-14" />

  <div class="mt-10">
    {
      ct.channels.map((ch) => (
        <div class="row grid gap-x-10 gap-y-2 md:grid-cols-[minmax(0,11rem)_1fr_auto] md:items-baseline">
          <h3 class="title-md !text-[1.0625rem]">{ch.label}</h3>
          <p class="m-0 max-w-[56ch] text-[0.9375rem] leading-relaxed text-fg-2">{ch.detail}</p>
          <a
            href={`mailto:${ch.email}`}
            class="text-[0.9375rem] text-brand-2-ink no-underline transition-opacity duration-200 hover:opacity-75"
          >
            {ch.email}
          </a>
        </div>
      ))
    }
  </div>

  <Footnotes notes={ct.footnotes} refPrefix="cfn" />
</section>
