---
import { getSiteContent } from '../../content/site'
import type { BrandTone } from '../../brand'
import type { Locale } from '../../content/site/types'
import PageHeader from '../PageHeader.astro'
import Bead from '../Bead.astro'
import SpecList from '../SpecList.astro'
import SectionHeading from '../SectionHeading.astro'
import Footnotes from '../Footnotes.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = getSiteContent(locale)
const p = c.products

const TONES: BrandTone[] = [2, 3, 1, 4]
---

<PageHeader heading={p.heading}>
  <p class="surface mt-7 mb-0 max-w-[68ch] text-[1.0625rem] leading-relaxed text-fg-2">
    {p.intro}
  </p>
</PageHeader>

<section class="shell">
  <article class="grid gap-x-12 gap-y-10 border-t border-line pt-14 lg:grid-cols-[1.15fr_1fr]">
    <div>
      <h2 class="title-xl">{p.entry.name}</h2>
      <p class="mt-5 mb-0 text-[clamp(1.0625rem,1.9vw,1.375rem)] leading-snug text-fg">
        {p.entry.tagline}
      </p>
      <p class="mt-8 mb-0 max-w-[58ch] text-[1rem] leading-relaxed text-fg-2">
        {p.entry.description}
      </p>
    </div>

    <SpecList
      locale={locale}
      label={p.specLabel}
      rows={p.entry.specs}
      refPrefix="pfn"
      class="lg:pt-2"
    />
  </article>
</section>

<section class="shell pt-24 sm:pt-32" id="scope">
  <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
    <SectionHeading title={p.scopeLabel} class="max-w-[20ch]" />
    <p class="m-0 text-[0.875rem] text-fg-3 tabular">
      {p.entry.scope.length}
      {' '}
      {c.ui.items}
    </p>
  </div>

  <p class="mt-6 mb-12 max-w-[68ch] text-[0.9375rem] leading-relaxed text-fg-2">{p.scopeNote}</p>

  <div>
    {
      p.entry.scope.map((item, i) => (
        <div class="row grid gap-x-12 gap-y-3 lg:grid-cols-[minmax(0,20rem)_1fr]">
          <div class="flex gap-5">
            <Bead tone={TONES[i % TONES.length]} class="mt-0.5" />
            <h3 class="title-md">{item.name}</h3>
          </div>
          <p class="m-0 max-w-[58ch] text-[0.9375rem] leading-relaxed text-fg-2">{item.detail}</p>
        </div>
      ))
    }
  </div>

  <Footnotes notes={p.footnotes} refPrefix="pfn" />
</section>
