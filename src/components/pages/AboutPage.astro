---
import { getSiteContent } from '../../content/site'
import type { BrandTone } from '../../brand'
import type { Locale } from '../../content/site/types'
import PageHeader from '../PageHeader.astro'
import Bead from '../Bead.astro'
import SpecList from '../SpecList.astro'
import SectionHeading from '../SectionHeading.astro'
import Footnotes from '../Footnotes.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = getSiteContent(locale)
const a = c.about

const TONES: BrandTone[] = [1, 2, 3, 4]
---

<PageHeader n={a.n} heading={a.heading} />

<section class="shell">
  <div class="grid gap-x-12 gap-y-14 border-t border-line pt-14 lg:grid-cols-[1.25fr_1fr]">
    <div class="max-w-[62ch]">
      {
        a.statement.map((para, i) => (
          <p
            class:list={[
              'mb-7 last:mb-0',
              i === 0
                ? 'text-[clamp(1.25rem,2.4vw,1.75rem)] leading-[1.4] tracking-[-0.02em] text-fg'
                : 'text-[1rem] leading-[1.8] text-fg-2',
            ]}
          >
            {para}
          </p>
        ))
      }
    </div>

    <SpecList locale={locale} label={a.factsLabel} rows={a.facts} refPrefix="afn" class="lg:pt-2" />
  </div>
</section>

<section class="shell pt-24 sm:pt-32" id="principles">
  <SectionHeading title={a.principlesLabel} class="max-w-[20ch]" />

  <div class="mt-12">
    {
      a.principles.map((pr, i) => (
        <div class="row grid gap-x-12 gap-y-4 lg:grid-cols-[minmax(0,22rem)_1fr]">
          <div class="flex gap-5">
            <Bead tone={TONES[i % TONES.length]} class="mt-1" />
            <h3 class="title-md">{pr.title}</h3>
          </div>
          <p class="m-0 max-w-[62ch] text-[1rem] leading-[1.75] text-fg-2">{pr.body}</p>
        </div>
      ))
    }
  </div>

  <Footnotes notes={a.footnotes} refPrefix="afn" />
</section>
