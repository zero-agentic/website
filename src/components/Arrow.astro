---
interface Props {
  /** 指向。默认向右 */
  dir?: 'right' | 'left'
  class?: string
}

const { dir = 'right', class: className } = Astro.props
---

{/*
  绘制的箭头，不是 Unicode 字形。比例与描边跟尺寸标注线同一套语汇：
  细长的杆、开口的箭头、无填充。
*/}
<svg
  viewBox="0 0 26 12"
  fill="none"
  aria-hidden="true"
  class:list={['h-3 w-[1.625rem] shrink-0', dir === 'left' && '-scale-x-100', className]}
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M0 6h23.5M18.5 1.5 23.75 6 18.5 10.5"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="square"
  ></path>
</svg>
