---
interface Props {
  /** 区段编号。与标题同基线排在一行，不是叠在标题上方的 kicker */
  n?: string
  title: string
  as?: 'h1' | 'h2'
  class?: string
}

const { n, title, as: Tag = 'h2', class: className }: Props = Astro.props
---

<Tag class:list={['title-lg flex items-baseline gap-4', className]}>
  {
    n && (
      <span class="shrink-0 text-[0.4em] font-semibold tracking-normal text-fg-3 tabular">
        {n.padStart(2, '0')}
      </span>
    )
  }
  <span>{title}</span>
</Tag>
